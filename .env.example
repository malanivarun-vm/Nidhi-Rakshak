# Required for database-backed migration/seed commands. Never use production here.
# Supabase Postgres connection string (use the pooler URL for Vercel).
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
NODE_ENV=development
NIDHI_FIXTURE_MODE=true
NEXT_PUBLIC_ANALYTICS_ENV=development
# Optional: only needed when a future implementation calls an AI provider.
AI_PROVIDER_API_KEY=
